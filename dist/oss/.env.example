# ─── Scratchy v2 — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── Ports ────────────────────────────────────────────────────────────────────
SCRATCHY_PORT=3002

# ── Encryption ───────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM user data encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── AI Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=



